# Multisampled draws and CB resolves on Metal (DECISIONS D27): Metal-only GPU tests. Included by Metal.cmake when BUILD_TESTING is on.
add_test_executable(agc_metal_msaa_tests ${agcMetalDir}/tests/MsaaDrawTests.mm)
target_include_directories(agc_metal_msaa_tests PRIVATE ${LIBS_INCLUDE_DIR} ${CMAKE_SOURCE_DIR}/core/shader/recompiler ${ANYPS5_VULKAN_HEADERS_INCLUDE_DIR} ${ANYPS5_SPIRV_HEADERS_INCLUDE_DIR})
target_link_libraries(agc_metal_msaa_tests PRIVATE libSceAgcDriver SDL2-static libc "-framework Metal" "-framework Foundation")
set_source_files_properties(${agcMetalDir}/tests/MsaaDrawTests.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
set_target_properties(agc_metal_msaa_tests PROPERTIES CXX_EXTENSIONS OFF OBJCXX_STANDARD 20)
if(CMAKE_CXX_COMPILER_LAUNCHER)
    set_property(TARGET agc_metal_msaa_tests PROPERTY OBJCXX_COMPILER_LAUNCHER ${CMAKE_CXX_COMPILER_LAUNCHER})
endif()
foreach(agcMetalMsaaMode IN ITEMS edges masks depth integer sampled emulated sampled8 interp interp_locations a2c storage ranges)
    add_test(NAME agc_metal_msaa_${agcMetalMsaaMode} COMMAND agc_metal_msaa_tests ${agcMetalMsaaMode})
    set_tests_properties(agc_metal_msaa_${agcMetalMsaaMode} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 30 LABELS gpu)
endforeach()
